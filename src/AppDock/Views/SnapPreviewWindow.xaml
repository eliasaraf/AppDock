<Window x:Class="AppDock.Views.SnapPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppDock preview"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        Opacity="0"
        Width="10" Height="10">
  <Border x:Name="Frame" Margin="6" CornerRadius="10" BorderThickness="2">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" />
    </Border.Effect>
    <Grid>
      <TextBlock x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="SemiBold"
                 Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="12" />
    </Grid>
  </Border>
</Window>
