<Window x:Class="AppDock.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AppDock"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">
  <StackPanel Margin="32,28,32,24">
    <StackPanel Orientation="Horizontal">
      <Image Source="/Assets/AppDock.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="AppDock" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}" />
      </StackPanel>
    </StackPanel>
    <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" FontSize="13"
               Text="Docks any application to a screen edge like the taskbar. Drag it between edges, float it, and hide or show it with a double tap of Ctrl." />
    <TextBlock x:Name="CopyrightText" Style="{StaticResource CardDescription}" Margin="0,16,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Open logs" Click="OnOpenLogs" />
      <Button Content="License" Margin="8,0,0,0" Click="OnLicense" />
      <Button Content="Close" Margin="8,0,0,0" IsCancel="True" IsDefault="True" MinWidth="80" Click="OnClose" />
    </StackPanel>
  </StackPanel>
</Window>
