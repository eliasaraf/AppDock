<Project>
  <PropertyGroup>
    <!-- Product identity: change these for your distribution. -->
    <Product>AppDock</Product>
    <Company>Saraf</Company>
    <Authors>Saraf</Authors>
    <Copyright>Copyright (c) 2026 Saraf. All rights reserved.</Copyright>
    <!-- Major.minor are set by hand. The third field is the build number, raised by build/build.ps1 on every run
         (Windows Installer ignores a fourth field when deciding whether to upgrade). -->
    <VersionMajorMinor>1.0</VersionMajorMinor>
    <BuildNumber>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)build\build-number.txt').Trim())</BuildNumber>
    <Version>$(VersionMajorMinor).$(BuildNumber)</Version>

    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
</Project>
