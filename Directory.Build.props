<Project>
  <PropertyGroup>
    <!-- Product identity: change these for your distribution. -->
    <Product>AppDock</Product>
    <Company>Saraf</Company>
    <Authors>Saraf</Authors>
    <Copyright>Copyright (c) 2026 Saraf. All rights reserved.</Copyright>
    <Version>1.0.0</Version>

    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
</Project>
